# ========== Python 构建产物（不上传）==========
__pycache__/
*.py[cod]
*.class
*.so
.Python
venv/
env/
ENV/
dist/
build/
*.spec

# ========== 运行时数据（不上传，每次运行自动重建）==========
data/conversations/
data/skills/*/versions/

# ========== Git LFS 跟踪的大文件（下面 .gitattributes 配置）==========
# models/*.gguf  → 模型文件（约 1.2 GB），LFS 跟踪
# python/        → 内嵌 Python 3.12（约 28 MB），LFS 跟踪
# llama/         → 推理引擎二进制（约 45 MB），LFS 跟踪
